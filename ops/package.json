{
  "name": "@zx402/ops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { "./*": "./src/*.ts" },
  "scripts": {
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "setup": "node --env-file=../.env --import tsx src/setup.ts",
    "deploy": "node --env-file=../.env --import tsx src/deploy.ts",
    "node": "node --env-file=../.env --import tsx src/node.ts",
    "demo": "node --env-file=../.env --import tsx src/demo.ts",
    "burst": "node --env-file=../.env --import tsx src/burst.ts",
    "masumi": "node --env-file=../.env --import tsx src/masumi.ts",
    "admin": "node --env-file=../.env --import tsx src/admin.ts"
  },
  "dependencies": {
    "@zx402/api": "*",
    "@zx402/asp": "*",
    "@zx402/core": "*",
    "@zx402/crank": "*",
    "@zx402/crypto": "*",
    "@zx402/example-x402-seller": "*",
    "@zx402/indexer": "*",
    "@zx402/prover": "*",
    "@zx402/relayer": "*",
    "@zx402/txlib": "*"
  }
}
